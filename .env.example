SILO_RUSTFS_DATA_DIR=/Volumes/Workspace/silo-data
SILO_RUSTFS_API_PORT=9000
SILO_RUSTFS_CONSOLE_PORT=9001
SILO_S3_RUSTFS=1
SILO_RUSTFS_ENDPOINT=http://127.0.0.1:9000
SILO_RUSTFS_BUCKET=silo-versioned-s3-tests
SILO_RUSTFS_ACCESS_KEY=siloadmin
SILO_RUSTFS_SECRET_KEY=silo-local-secret-change-me
SILO_RUSTFS_RPC_SECRET=silo-local-rpc-secret-change-me
SILO_RUSTFS_LOG_LEVEL=info
# Opt in only for explicit qualification runs.
SILO_S3_BENCHMARK=0
SILO_S3_RESOURCE_TEST=0

# Opt-in real AWS qualification. Credentials come from the ordinary AWS SDK
# default chain; these buckets must be isolated and have no conflicting
# lifecycle rule or default Object Lock retention.
SILO_S3_AWS=0
SILO_AWS_REGION=us-west-2
SILO_AWS_BUCKET_UNVERSIONED=
SILO_AWS_BUCKET_VERSIONED=
# Optional comma-separated real directory/access-point/Object-Lambda/
# Outposts/MRAP identifiers that must fail before any probe write.
SILO_AWS_REJECT_IDENTIFIERS=
